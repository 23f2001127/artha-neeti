# Required. See README.md's "Running it locally" for where to get each of
# these free-tier keys and what a Postgres DATABASE_URL should look like
# (a free Supabase project with the `vector` extension works).
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Everything below is optional - only set it to override the default ---

# Overrides the primary Groq reasoning model (agents/_base.py). The fallback
# chain behind it is not configurable via env var - see agents/README.md.
# GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Overrides the primary Gemini model used for news-sentiment classification
# and filings embeddings (mcp_servers/research_mcp, filings_rag_mcp).
# GEMINI_MODEL=gemini-3-flash-preview

# shared/llm_rate_limiter.py tuning - the defaults are tuned against this
# project's actual measured free-tier behavior (see agents/README.md); only
# change these if you're on a different tier or a paid key.
# LLM_RL_WINDOW_SECONDS=60
# LLM_RL_GENERATE_RPD=20
# LLM_RL_GENERATE_RPM=6
# LLM_RATE_LIMITER_DB=./.llm_rate_limiter.db

# agents/planner.py - caps how many companies' specialists run concurrently.
# Leave unset for the auto default (2 for a single-company run, 1 for
# multi-company, to stay under the shared Groq rate-limit bucket).
# PLANNER_MAX_CONCURRENCY=

# mcp_servers/filings_rag_mcp/config.py - chunking/embedding tuning for
# filings ingestion. Defaults match what the ingested corpus was built with;
# changing these requires re-ingesting to stay consistent.
# FILINGS_EMBED_MODEL=gemini-embedding-001
# FILINGS_EMBED_DIM=768
# FILINGS_CHUNK_TOKENS=1100
# FILINGS_CHUNK_OVERLAP=150
# FILINGS_EMBED_BATCH_TOKENS=22000

# Test-suite-only pacing knobs (agents/test_*.py, shared/test_llm_rate_limiter.py) -
# not read by the running app, only by the test files when you run them
# directly against live quota. Not needed to run ArthaNeeti itself.
# API_TEST_TIMEOUT_S=
# GEMINI_TEST_SPACING_S=
# GROQ_TEST_GAP_S=
# PLANNER_TEST_GAP_S=
# PLANNER_ROUTING_GAP_S=
# SYNTH_TEST_GAP_S=
