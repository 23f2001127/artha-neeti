# Copy to .env and fill in the four required values. All providers have free tiers.

GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
# Postgres with the pgvector extension, e.g. a Supabase project.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---------------------------------------------------------------- deployment

# Allowed browser origins besides localhost, comma-separated.
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# New research jobs per 24 hours across all visitors (0 = no limit).
# MAX_DAILY_JOBS=0
# Requests per minute per client IP on job-creating endpoints.
# IP_THROTTLE_PER_MINUTE=6

# ---------------------------------------------------------------- models and limits

# Primary Groq model; the fallback chain is fixed in agents/_base.py.
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# Per-request token ceiling (input + output) before a request is trimmed.
# GROQ_REQUEST_TOKEN_LIMIT=8000
# First Gemini model tried for sentiment classification.
# GEMINI_MODEL=gemini-3-flash-preview
# Specialist agents run at once (default: 2 for one company, 1 for several).
# PLANNER_MAX_CONCURRENCY=

# Shared rate-limiter ledger location and limit overrides
# (LLM_RL_<FAMILY>_RPM / _TPM / _RPD, family = groq, generate or embed).
# LLM_RATE_LIMITER_DB=./.llm_rate_limiter.db
# LLM_RL_GROQ_TPM=5000

# ---------------------------------------------------------------- filings index

# Changing these requires re-indexing the annual reports.
# FILINGS_EMBED_MODEL=gemini-embedding-001
# FILINGS_EMBED_DIM=768
# FILINGS_CHUNK_TOKENS=1100
# FILINGS_CHUNK_OVERLAP=150
# FILINGS_EMBED_BATCH_TOKENS=22000

# ---------------------------------------------------------------- live tests only

# Pacing for `pytest --live` (tests/integration); not read by the application.
# API_TEST_TIMEOUT_S=
# GEMINI_TEST_SPACING_S=
# GROQ_TEST_GAP_S=
# PLANNER_TEST_GAP_S=
# PLANNER_ROUTING_GAP_S=
# SYNTH_TEST_GAP_S=
# LLM_RL_WINDOW_SECONDS=60
