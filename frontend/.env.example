# Dev: target for the Vite proxy (/api/* -> this). Defaults to the local
# uvicorn backend if unset, so this file only needs to exist for reference.
VITE_API_BASE=http://127.0.0.1:8000

# Production build only: when set, the app calls this URL directly instead of
# the relative /api/* proxy path (which does not exist outside `vite dev`).
# VITE_API_BASE_DIRECT=https://your-deployed-backend.example.com
